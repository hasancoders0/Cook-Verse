  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Ilish into medium pieces. Rub with a little turmeric and salt. Keep aside for 10–15 minutes.",
        "bn": "ইলিশ মাছ পরিষ্কার করে মাঝারি টুকরো করুন। অল্প হলুদ ও লবণ মেখে ১০–১৫ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan until it smokes lightly. Fry the fish pieces carefully on both sides until light golden. Remove and set aside.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। মাছের টুকরোগুলো সাবধানে দুই পাশে হালকা সোনালি করে ভেজে তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Cook the Onion Base",
        "bn": "পেঁয়াজের বেস তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add the thinly sliced onions and fry on medium heat until soft and golden. Add ginger-garlic paste and sauté until the raw smell disappears.",
        "bn": "একই তেলে পাতলা কাটা পেঁয়াজ দিয়ে মিডিয়াম আঁচে নরম ও সোনালি করে ভাজুন। আদা-রসুন বাটা দিয়ে কাঁচা গন্ধ না যাওয়া পর্যন্ত কষিয়ে নিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Spices and Bhuna",
        "bn": "মসলা দিয়ে ভুনা করুন"
      },
      "description": {
        "en": "Add turmeric, red chili powder, cumin powder, coriander powder, and salt. Sprinkle a little water and cook the spices on medium heat until the oil separates and the masala becomes thick and aromatic.",
        "bn": "হলুদ, লাল মরিচ, জিরা, ধনিয়ার গুঁড়া ও লবণ দিন। অল্প পানি ছিটিয়ে মিডিয়াম আঁচে তেল উপরে ভেসে না আসা এবং মসলা ঘন ও সুগন্ধি হওয়া পর্যন্ত কষান।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Fish and Finish",
        "bn": "মাছ দিয়ে শেষ করুন"
      },
      "description": {
        "en": "Gently add the fried fish pieces and green chilies. Mix carefully so the spices coat the fish. Cover and cook on low heat for 8–10 minutes until the gravy thickens and oil floats on top. Finish with garam masala and chopped coriander.",
        "bn": "ভাজা মাছের টুকরো ও কাঁচা মরিচ আলতো করে দিন। সাবধানে মিশিয়ে মসলা মাছের সাথে লেগে যায়। ঢাকনা দিয়ে কম আঁচে ৮–১০ মিনিট রান্না করুন যতক্ষণ না ঝোল ঘন হয় ও তেল উপরে ভেসে ওঠে। শেষে গরম মসলা ও ধনেপাতা কুচি দিন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve hot with steamed rice. This everyday Ilish Bhuna is delicious for both lunch and dinner.",
        "bn": "গরম গরম ভাতের সাথে পরিবেশন করুন। এই দৈনন্দিন ইলিশ ভুনা দুপুর ও রাতের খাবার উভয়ের জন্যই সুস্বাদু।"
      }
    }
  ],

  "tips": [
    {
      "en": "Do not over-stir the fish after adding it — Ilish is delicate and breaks easily.",
      "bn": "মাছ দেওয়ার পর বেশি নাড়বেন না — ইলিশ নরম, সহজে ভেঙে যায়।"
    },
    {
      "en": "Proper bhuna (cooking until oil separates) is the key to authentic flavor and color.",
      "bn": "সঠিক ভুনা (তেল উপরে ভেসে না আসা পর্যন্ত কষানো) আসল স্বাদ ও রঙের চাবিকাঠি।"
    },
    {
      "en": "Mustard oil gives the classic Bangladeshi aroma — heat it until it smokes before cooking.",
      "bn": "সরিষার তেল ক্লাসিক বাংলাদেশি সুগন্ধ দেয় — রান্নার আগে ধোঁয়া বের হওয়া পর্যন্ত গরম করুন।"
    }
  ],

