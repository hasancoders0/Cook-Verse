  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Preheat oven to 190°C (375°F). Pat the cod fillets dry and season both sides with salt, black pepper, and a little lemon juice. Arrange in a lightly greased baking dish.",
        "bn": "ওভেন ১৯০°C (৩৭৫°F) প্রিহিট করুন। কড ফিলেট শুকিয়ে দুই পাশে লবণ, গোলমরিচ ও অল্প লেবুর রস মেখে নিন। হালকা তেল মাখানো বেকিং ডিশে সাজান।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Make the Cream Sauce",
        "bn": "ক্রিম সস তৈরি করুন"
      },
      "description": {
        "en": "In a saucepan, melt the butter over medium heat. Add minced garlic and cook for 30 seconds. Stir in the flour and cook for 1 minute. Gradually whisk in the milk and cream until smooth and thickened. Add Dijon mustard, dried parsley, salt, and pepper. Simmer for 2–3 minutes.",
        "bn": "সসপ্যানে মাঝারি আঁচে বাটার গলিয়ে নিন। কুচি রসুন দিয়ে ৩০ সেকেন্ড রান্না করুন। ময়দা দিয়ে ১ মিনিট নাড়ুন। ধীরে ধীরে দুধ ও ক্রিম ফেটিয়ে মসৃণ ও ঘন করুন। ডিজন মাস্টার্ড, শুকনো পার্সলে, লবণ ও গোলমরিচ দিয়ে ২–৩ মিনিট সিদ্ধ করুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Assemble the Bake",
        "bn": "বেক একত্র করুন"
      },
      "description": {
        "en": "Pour the cream sauce evenly over the cod fillets. Sprinkle grated cheddar and parmesan cheese on top.",
        "bn": "ক্রিম সস কড ফিলেটের উপর সমানভাবে ঢেলে দিন। উপরে কুচি করা চেডার ও পারমেসান চিজ ছিটিয়ে দিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Bake",
        "bn": "বেক করুন"
      },
      "description": {
        "en": "Bake in the preheated oven for 20–25 minutes until the fish is cooked through, the sauce is bubbling, and the cheese topping is golden brown.",
        "bn": "প্রিহিটেড ওভেনে ২০–২৫ মিনিট বেক করুন যতক্ষণ না মাছ সেদ্ধ হয়, সস ফুটতে থাকে এবং চিজ টপিং সোনালি বাদামি হয়।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Rest and Serve",
        "bn": "বিশ্রাম দিয়ে পরিবেশন করুন"
      },
      "description": {
        "en": "Remove from the oven and let it rest for 3–4 minutes. Garnish with fresh parsley if desired and serve hot with steamed vegetables, salad, or crusty bread.",
        "bn": "ওভেন থেকে বের করে ৩–৪ মিনিট বিশ্রাম দিন। ইচ্ছে করলে তাজা পার্সলে দিয়ে সাজিয়ে গরম গরম স্টিমড সবজি, সালাদ বা ক্রাস্টি ব্রেডের সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Do not overbake the cod — it should be just cooked and still moist.",
      "bn": "কড অতিরিক্ত বেক করবেন না — ঠিকমতো সেদ্ধ ও রসালো থাকা উচিত।"
    },
    {
      "en": "For extra flavor, add a pinch of nutmeg to the cream sauce.",
      "bn": "অতিরিক্ত স্বাদের জন্য ক্রিম সসে এক চিমটি জায়ফল যোগ করতে পারেন।"
    },
    {
      "en": "This dish looks elegant on the table and is ideal for special dinners.",
      "bn": "এই পদ টেবিলে মার্জিত দেখায় এবং বিশেষ রাতের খাবারের জন্য আদর্শ।"
    }
  ],

