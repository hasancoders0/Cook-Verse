  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Mustard Paste",
        "bn": "সরিষা বাটা তৈরি করুন"
      },
      "description": {
        "en": "Soak yellow and black mustard seeds for 20–30 minutes. Grind them with green chilies, turmeric, salt, and a little water into a smooth paste.",
        "bn": "হলুদ ও কালো সরিষা ২০–৩০ মিনিট ভিজিয়ে রাখুন। কাঁচা মরিচ, হলুদ, লবণ ও অল্প পানি দিয়ে মসৃণ বাটা তৈরি করুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean the Koi fish thoroughly, score the skin lightly, and pat dry. Rub with a little turmeric and salt. Keep aside for 10 minutes.",
        "bn": "কই মাছ ভালোভাবে পরিষ্কার করে চামড়ায় হালকা স্কোর দিন এবং শুকিয়ে নিন। অল্প হলুদ ও লবণ মেখে ১০ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Lightly Fry the Fish",
        "bn": "মাছ হালকা ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan until it smokes lightly. Lightly fry the fish on both sides for 2–3 minutes until the surface firms up. Remove and set aside.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। মাছ দুই পাশে ২–৩ মিনিট হালকা ভেজে নিন যতক্ষণ না উপরের অংশ শক্ত হয়। তুলে রাখুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Make the Mustard Gravy",
        "bn": "সরিষা ঝোল তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add nigella seeds. When they splutter, add the mustard paste and cook on low heat for 1–2 minutes. Add water, remaining salt, and slit green chilies. Bring to a gentle simmer.",
        "bn": "একই তেলে কালোজিরা দিন। ফোড়ন উঠলে সরিষা বাটা দিয়ে কম আঁচে ১–২ মিনিট কষিয়ে নিন। পানি, বাকি লবণ ও চিরা কাঁচা মরিচ দিয়ে হালকা সিদ্ধ করুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Fish and Finish",
        "bn": "মাছ দিয়ে শেষ করুন"
      },
      "description": {
        "en": "Gently place the fried Koi fish into the gravy. Cover and cook on low heat for 10–12 minutes until the fish is fully cooked and the gravy is aromatic. Avoid stirring too much.",
        "bn": "ভাজা কই মাছ আলতো করে ঝোলে দিন। ঢাকনা দিয়ে কম আঁচে ১০–১২ মিনিট রান্না করুন যতক্ষণ না মাছ সেদ্ধ হয় এবং ঝোল সুগন্ধি হয়। বেশি নাড়বেন না।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve hot with steamed rice. This mustard-based Koi dish is excellent for entertaining guests.",
        "bn": "গরম গরম ভাতের সাথে পরিবেশন করুন। এই সরিষাভিত্তিক কই মাছের পদ অতিথি আপ্যায়নের জন্য চমৎকার।"
      }
    }
  ],

  "tips": [
    {
      "en": "Scoring the Koi fish helps the mustard paste penetrate better.",
      "bn": "কই মাছে স্কোর দিলে সরিষা বাটা ভালোভাবে ঢোকে।"
    },
    {
      "en": "Cook the mustard paste on low heat to avoid bitterness.",
      "bn": "সরিষা বাটা কম আঁচে কষান যাতে তেতো না হয়।"
    },
    {
      "en": "A final drizzle of raw mustard oil before serving enhances the authentic aroma.",
      "bn": "পরিবেশনের আগে অল্প কাঁচা সরিষার তেল ছিটিয়ে দিলে আসল সুগন্ধ বাড়ে।"
    }
  ],

