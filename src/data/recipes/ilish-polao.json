  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish and Rice",
        "bn": "মাছ ও চাল প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Ilish into medium pieces. Rub with a little turmeric and salt. Wash the rice thoroughly and soak for 20 minutes. Drain well.",
        "bn": "ইলিশ মাছ পরিষ্কার করে মাঝারি টুকরো করুন। অল্প হলুদ ও লবণ মেখে রাখুন। চাল ভালোভাবে ধুয়ে ২০ মিনিট ভিজিয়ে রাখুন। পানি ঝরিয়ে নিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan. Lightly fry the fish pieces on both sides until the surface firms up. Remove and keep aside.",
        "bn": "সরিষার তেল গরম করে মাছের টুকরোগুলো দুই পাশে হালকা ভেজে নিন যতক্ষণ না উপরের অংশ শক্ত হয়। তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Make the Polao Base",
        "bn": "পোলাওয়ের বেস তৈরি করুন"
      },
      "description": {
        "en": "In a heavy pot, heat ghee. Add bay leaf, cinnamon, cardamom, and cloves. Add sliced onion and fry until light golden. Add ginger-garlic paste and sauté. Then add beaten yogurt, green chilies, and salt. Cook for 2 minutes.",
        "bn": "ভারী হাঁড়িতে ঘি গরম করুন। তেজপাতা, দারুচিনি, এলাচ ও লবঙ্গ দিন। পেঁয়াজ কুচি দিয়ে হালকা সোনালি করে ভাজুন। আদা-রসুন বাটা দিয়ে কষিয়ে নিন। তারপর ফেটানো দই, কাঁচা মরিচ ও লবণ দিয়ে ২ মিনিট রান্না করুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Rice and Water",
        "bn": "চাল ও পানি দিন"
      },
      "description": {
        "en": "Add the drained rice and gently mix for 1–2 minutes so the grains are coated. Pour in the water and bring to a boil. Reduce heat, cover, and cook until the rice is 70–80% done.",
        "bn": "ঝরানো চাল দিয়ে ১–২ মিনিট আলতো করে মিশিয়ে নিন যাতে দানাগুলো কোট হয়। পানি দিয়ে ফুটিয়ে তুলুন। আঁচ কমিয়ে ঢাকনা দিয়ে চাল ৭০–৮০% সেদ্ধ হওয়া পর্যন্ত রান্না করুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Fish and Dum",
        "bn": "মাছ দিয়ে দম দিন"
      },
      "description": {
        "en": "Gently place the fried fish pieces on top of the rice. Sprinkle fried onion (beresta). Cover tightly and cook on the lowest heat (dum) for 10–12 minutes until the rice is fully cooked and aromatic.",
        "bn": "ভাজা মাছের টুকরোগুলো চালের উপর আলতো করে সাজান। ভাজা পেঁয়াজ (বেরেস্তা) ছিটিয়ে দিন। ভালোভাবে ঢেকে সবচেয়ে কম আঁচে ১০–১২ মিনিট দম দিন যতক্ষণ না চাল পুরোপুরি সেদ্ধ ও সুগন্ধি হয়।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Let it rest for 5 minutes. Gently fluff and serve hot. Perfect for special occasion lunches.",
        "bn": "৫ মিনিট বিশ্রাম দিন। আলতো করে নেড়ে গরম গরম পরিবেশন করুন। বিশেষ অনুষ্ঠানের দুপুরের খাবারের জন্য পারফেক্ট।"
      }
    }
  ],

  "tips": [
    {
      "en": "Use good quality aromatic rice (Chinigura or Kalijira) for authentic taste and fragrance.",
      "bn": "আসল স্বাদ ও সুগন্ধের জন্য ভালো মানের সুগন্ধি চাল (চিনিগুঁড়া বা কালিজিরা) ব্যবহার করুন।"
    },
    {
      "en": "Do not stir vigorously after adding the fish — Ilish breaks easily.",
      "bn": "মাছ দেওয়ার পর জোরে নাড়বেন না — ইলিশ সহজে ভেঙে যায়।"
    },
    {
      "en": "A final touch of pure ghee and beresta makes the polao extra special for guests.",
      "bn": "শেষে খাঁটি ঘি ও বেরেস্তা দিলে পোলাও অতিথিদের জন্য আরও বিশেষ হয়ে ওঠে।"
    }
  ],

