  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Season the Beef",
        "bn": "গরুর কিমায় মসলা মেশান"
      },
      "description": {
        "en": "Place the ground beef in a mixing bowl. Sprinkle with salt and black pepper. Gently mix with your hands just until combined—do not overwork the meat.",
        "bn": "মিক্সিং বোলে গরুর কিমা রাখুন। লবণ ও গোলমরিচ ছিটিয়ে দিন। হাত দিয়ে আলতো করে মিশিয়ে নিন—অতিরিক্ত মেখে ফেলবেন না।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Shape the Patties",
        "bn": "প্যাটি তৈরি করুন"
      },
      "description": {
        "en": "Divide the beef into two equal portions (about 200 g each). Gently shape into patties slightly larger than the buns. Press a small dimple in the center of each patty so it cooks evenly.",
        "bn": "কিমা দুই সমান অংশে ভাগ করুন (প্রায় ২০০ গ্রাম করে)। বানের চেয়ে একটু বড় করে আলতো করে প্যাটি বানান। সমানভাবে রান্না হওয়ার জন্য প্রতিটি প্যাটির মাঝখানে হালকা গর্ত চাপুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Cook the Patties",
        "bn": "প্যাটি রান্না করুন"
      },
      "description": {
        "en": "Heat a grill pan or skillet over medium-high heat. Cook the patties for 4–5 minutes per side for medium doneness (internal temperature 160°F / 71°C). Flip only once.",
        "bn": "মিডিয়াম-হাই হিটে গ্রিল প্যান বা স্কিলেট গরম করুন। মিডিয়াম ডোনেসের জন্য প্রতি পাশে ৪–৫ মিনিট করে রান্না করুন (ভিতরের তাপমাত্রা ১৬০°F / ৭১°C)। শুধু একবার উল্টান।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Cheese",
        "bn": "চিজ যোগ করুন"
      },
      "description": {
        "en": "During the last minute of cooking, place one slice of cheddar cheese on each patty and cover the pan briefly so the cheese melts.",
        "bn": "রান্নার শেষ এক মিনিটে প্রতিটি প্যাটির উপর এক স্লাইস চেডার চিজ রাখুন এবং চিজ গলানোর জন্য প্যান ঢেকে দিন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Assemble the Burger",
        "bn": "বার্গার তৈরি করুন"
      },
      "description": {
        "en": "Lightly toast the buns. Spread mayonnaise and ketchup on the cut sides. Layer lettuce, tomato slices, onion rings, pickles, the cheesy patty, and the top bun. Serve immediately.",
        "bn": "বান হালকা টোস্ট করুন। কাটা দিকে মেয়োনিজ ও কেচাপ লাগান। লেটুস, টমেটো স্লাইস, পেঁয়াজ রিং, পিকলস, চিজযুক্ত প্যাটি এবং উপরের বান স্তরে স্তরে সাজান। সাথে সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Let the cooked patties rest for 2 minutes before assembling so the juices redistribute.",
      "bn": "রস সমানভাবে ছড়িয়ে পড়ার জন্য রান্না করা প্যাটিগুলো একত্র করার আগে ২ মিনিট বিশ্রাম দিন।"
    },
    {
      "en": "Use freshly ground beef (or ask the butcher to grind it) for the best flavor and texture.",
      "bn": "সেরা স্বাদ ও টেক্সচারের জন্য তাজা কিমা ব্যবহার করুন (বা কসাইকে কিমা করতে বলুন)।"
    },
    {
      "en": "Do not press down on the patties while cooking—this squeezes out the juices.",
      "bn": "রান্নার সময় প্যাটির উপর চাপ দেবেন না—এতে রস বের হয়ে যায়।"
    }
  ],

