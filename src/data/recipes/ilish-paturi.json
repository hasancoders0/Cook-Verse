  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Mustard Paste",
        "bn": "সরিষা বাটা তৈরি করুন"
      },
      "description": {
        "en": "Soak yellow and black mustard seeds for 30 minutes. Grind them with green chilies, grated coconut, turmeric, salt, and a little water into a smooth thick paste. Mix in the mustard oil.",
        "bn": "হলুদ ও কালো সরিষা ৩০ মিনিট ভিজিয়ে রাখুন। কাঁচা মরিচ, কুচি নারকেল, হলুদ, লবণ ও অল্প পানি দিয়ে মসৃণ ঘন বাটা তৈরি করুন। সরিষার তেল মিশিয়ে নিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Marinate the Fish",
        "bn": "মাছ মেরিনেট করুন"
      },
      "description": {
        "en": "Clean and cut the Ilish into thick pieces. Coat each piece generously with the mustard-coconut paste. Let it marinate for at least 15–20 minutes.",
        "bn": "ইলিশ মাছ পরিষ্কার করে মোটা টুকরো করুন। প্রতিটি টুকরোতে সরিষা-নারকেল বাটা ভালোভাবে মাখিয়ে কমপক্ষে ১৫–২০ মিনিট মেরিনেট করুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Prepare the Banana Leaves",
        "bn": "কলার পাতা প্রস্তুত করুন"
      },
      "description": {
        "en": "Wash the banana leaves and pass them lightly over a flame so they become soft and pliable. Cut into pieces large enough to wrap each fish portion.",
        "bn": "কলার পাতা ধুয়ে আগুনের উপর হালকা সেঁকে নরম ও নমনীয় করে নিন। প্রতিটি মাছের টুকরো মুড়ানোর মতো আকারে কেটে নিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Wrap the Fish",
        "bn": "মাছ মুড়িয়ে নিন"
      },
      "description": {
        "en": "Place one marinated fish piece in the center of a banana leaf. Fold the leaf into a neat parcel and secure with thread or toothpick. Repeat for all pieces.",
        "bn": "মেরিনেট করা মাছের একটি টুকরো কলার পাতার মাঝখানে রাখুন। পাতা ভাঁজ করে সুন্দর প্যাকেট তৈরি করুন এবং সুতা বা টুথপিক দিয়ে বেঁধে দিন। সব টুকরোর জন্য একইভাবে করুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Steam the Paturi",
        "bn": "পাতুরি ভাপুন"
      },
      "description": {
        "en": "Arrange the parcels in a steamer or on a plate inside a large pot with a little water. Cover tightly and steam on medium heat for 20–25 minutes until the fish is cooked through.",
        "bn": "প্যাকেটগুলো স্টিমারে বা অল্প পানি দেওয়া বড় হাঁড়ির ভিতরের প্লেটে সাজান। ভালোভাবে ঢেকে মিডিয়াম আঁচে ২০–২৫ মিনিট ভাপুন যতক্ষণ না মাছ সেদ্ধ হয়।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Open the parcels carefully at the table so the aroma is released. Serve hot with steamed rice. Ideal for special occasions.",
        "bn": "টেবিলে সাবধানে প্যাকেট খুলে সুগন্ধ ছড়িয়ে দিন। গরম গরম ভাতের সাথে পরিবেশন করুন। বিশেষ অনুষ্ঠানের জন্য আদর্শ।"
      }
    }
  ],

  "tips": [
    {
      "en": "Fresh banana leaves give the best aroma. If unavailable, you can use parchment paper, but the traditional flavor will be milder.",
      "bn": "তাজা কলার পাতা সবচেয়ে ভালো সুগন্ধ দেয়। না পেলে পার্চমেন্ট পেপার ব্যবহার করতে পারেন, তবে ঐতিহ্যবাহী স্বাদ একটু কম হবে।"
    },
    {
      "en": "Do not make the mustard paste too watery — it should be thick so it clings to the fish.",
      "bn": "সরিষা বাটা খুব পাতলা করবেন না — ঘন হওয়া উচিত যাতে মাছের সাথে লেগে থাকে।"
    },
    {
      "en": "Steaming is traditional, but you can also slow-cook the parcels in a covered pan with very little oil for a slightly different texture.",
      "bn": "ভাপানোই ঐতিহ্যবাহী পদ্ধতি, তবে খুব অল্প তেলে ঢাকা প্যানে ধীরে রান্না করলেও ভিন্ন টেক্সচার পাওয়া যায়।"
    }
  ],

