  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Ingredients",
        "bn": "উপকরণ প্রস্তুত করুন"
      },
      "description": {
        "en": "Wash the rice and moong dal separately. Lightly roast the moong dal in a dry pan until aromatic. Clean and cut the Ilish into medium pieces. Rub with a little turmeric and salt.",
        "bn": "চাল ও মুগ ডাল আলাদা করে ধুয়ে নিন। মুগ ডাল শুকনো কড়াইতে হালকা ভেজে সুগন্ধি করে নিন। ইলিশ মাছ পরিষ্কার করে মাঝারি টুকরো করুন এবং অল্প হলুদ-লবণ মেখে রাখুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan. Lightly fry the Ilish pieces on both sides until the surface firms up. Remove and keep aside.",
        "bn": "সরিষার তেল গরম করে ইলিশের টুকরোগুলো দুই পাশে হালকা ভেজে নিন যতক্ষণ না উপরের অংশ শক্ত হয়। তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Make the Khichuri Base",
        "bn": "খিচুড়ির বেস তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add bay leaves and sliced onion. Fry until soft. Add ginger-garlic paste and sauté. Then add turmeric, cumin powder, and green chilies.",
        "bn": "একই তেলে তেজপাতা ও পেঁয়াজ কুচি দিয়ে নরম করে ভাজুন। আদা-রসুন বাটা দিয়ে কষিয়ে নিন। তারপর হলুদ, জিরা গুঁড়া ও কাঁচা মরিচ দিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Cook Rice and Dal",
        "bn": "চাল ও ডাল রান্না করুন"
      },
      "description": {
        "en": "Add the washed rice and roasted moong dal. Stir for 1–2 minutes. Pour in the water and salt. Bring to a boil, then cover and cook on medium heat until the rice and dal are almost done (about 15–18 minutes).",
        "bn": "ধোয়া চাল ও ভাজা মুগ ডাল দিন। ১–২ মিনিট নাড়ুন। পানি ও লবণ দিয়ে ফুটিয়ে তুলুন। ঢাকনা দিয়ে মিডিয়াম আঁচে চাল ও ডাল প্রায় সেদ্ধ হওয়া পর্যন্ত রান্না করুন (প্রায় ১৫–১৮ মিনিট)।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add the Fish",
        "bn": "মাছ যোগ করুন"
      },
      "description": {
        "en": "Gently place the fried Ilish pieces on top of the khichuri. Do not stir vigorously. Cover and cook on low heat for another 8–10 minutes until the fish is cooked and the khichuri reaches a soft, porridge-like consistency.",
        "bn": "ভাজা ইলিশের টুকরোগুলো খিচুড়ির উপর আলতো করে সাজিয়ে দিন। জোরে নাড়বেন না। ঢাকনা দিয়ে কম আঁচে আরও ৮–১০ মিনিট রান্না করুন যতক্ষণ না মাছ সেদ্ধ হয় এবং খিচুড়ি নরম হয়।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Finish and Serve",
        "bn": "শেষ করুন ও পরিবেশন করুন"
      },
      "description": {
        "en": "Drizzle ghee on top, sprinkle chopped coriander, and let it rest for 5 minutes. Serve hot. Traditionally enjoyed during the monsoon season.",
        "bn": "উপরে ঘি ছিটিয়ে ধনেপাতা কুচি দিন এবং ৫ মিনিট বিশ্রাম দিন। গরম গরম পরিবেশন করুন। বর্ষাকালে ঐতিহ্যগতভাবে উপভোগ করা হয়।"
      }
    }
  ],

  "tips": [
    {
      "en": "Do not over-stir after adding the fish — Ilish is delicate and breaks easily.",
      "bn": "মাছ দেওয়ার পর বেশি নাড়বেন না — ইলিশ নরম, সহজে ভেঙে যায়।"
    },
    {
      "en": "Roasting the moong dal lightly before cooking gives better flavor and aroma.",
      "bn": "রান্নার আগে মুগ ডাল হালকা ভেজে নিলে স্বাদ ও সুগন্ধ ভালো হয়।"
    },
    {
      "en": "Ilish Khichuri tastes best on rainy days with a side of fried eggplant or simple omelette.",
      "bn": "ইলিশ খিচুড়ি বর্ষার দিনে ভাজা বেগুন বা সাধারণ অমলেটের সাথে সবচেয়ে ভালো লাগে।"
    }
  ],

