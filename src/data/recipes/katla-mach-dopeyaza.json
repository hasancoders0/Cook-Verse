  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Katla into medium-thick pieces. Rub with turmeric and salt. Keep aside for 10–15 minutes.",
        "bn": "কাতলা মাছ পরিষ্কার করে মাঝারি মোটা টুকরো করুন। হলুদ ও লবণ মেখে ১০–১৫ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan until it smokes lightly. Fry the fish pieces carefully on both sides until light golden. Remove and set aside.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। মাছের টুকরোগুলো সাবধানে দুই পাশে হালকা সোনালি করে ভেজে তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Cook the Onions",
        "bn": "পেঁয়াজ কষিয়ে নিন"
      },
      "description": {
        "en": "In the same oil, add the thinly sliced onions. Fry on medium heat until they become soft and turn light golden. This large quantity of onion is the signature of Dopeyaza.",
        "bn": "একই তেলে পাতলা কাটা পেঁয়াজ দিন। মিডিয়াম আঁচে নরম ও হালকা সোনালি হওয়া পর্যন্ত ভাজুন। প্রচুর পেঁয়াজই দোপেয়াজার বৈশিষ্ট্য।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Spices",
        "bn": "মসলা যোগ করুন"
      },
      "description": {
        "en": "Add ginger-garlic paste and sauté until the raw smell disappears. Then add turmeric, chili powder, cumin powder, coriander powder, and salt. Sprinkle a little water and cook until the oil starts to separate.",
        "bn": "আদা-রসুন বাটা দিয়ে কাঁচা গন্ধ না যাওয়া পর্যন্ত কষিয়ে নিন। তারপর হলুদ, মরিচ, জিরা, ধনিয়ার গুঁড়া ও লবণ দিন। অল্প পানি ছিটিয়ে তেল উপরে ভেসে না আসা পর্যন্ত কষান।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Fish and Finish",
        "bn": "মাছ দিয়ে শেষ করুন"
      },
      "description": {
        "en": "Gently add the fried fish pieces and green chilies. Mix carefully so the onion-spice mixture coats the fish. Cover and cook on low heat for 8–10 minutes until the gravy thickens slightly and oil floats on top. Finish with garam masala and chopped coriander.",
        "bn": "ভাজা মাছের টুকরো ও কাঁচা মরিচ আলতো করে দিন। সাবধানে মিশিয়ে পেঁয়াজ-মসলা মাছের সাথে লেগে যায়। ঢাকনা দিয়ে কম আঁচে ৮–১০ মিনিট রান্না করুন যতক্ষণ না ঝোল একটু ঘন হয় ও তেল উপরে ভেসে ওঠে। শেষে গরম মসলা ও ধনেপাতা কুচি দিন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve hot with steamed rice. This rich onion-based Dopeyaza is ideal for special occasion lunches.",
        "bn": "গরম গরম ভাতের সাথে পরিবেশন করুন। এই পেঁয়াজভিত্তিক সমৃদ্ধ দোপেয়াজা বিশেষ অনুষ্ঠানের দুপুরের খাবারের জন্য আদর্শ।"
      }
    }
  ],

  "tips": [
    {
      "en": "Use plenty of onions — that is the real meaning of “Dopeyaza”.",
      "bn": "প্রচুর পেঁয়াজ ব্যবহার করুন — এটাই “দোপেয়াজা”-র আসল অর্থ।"
    },
    {
      "en": "Do not over-stir the fish after adding it; Katla pieces can break if handled roughly.",
      "bn": "মাছ দেওয়ার পর বেশি নাড়বেন না; কাতলার টুকরো রুক্ষভাবে নাড়লে ভেঙে যেতে পারে।"
    },
    {
      "en": "A semi-dry consistency with oil floating on top is the hallmark of a good Dopeyaza.",
      "bn": "অর্ধ-শুকনো গঠন ও উপরে তেল ভাসমান থাকাই ভালো দোপেয়াজার বৈশিষ্ট্য।"
    }
  ],

