  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Mustard Paste",
        "bn": "সরিষা বাটা তৈরি করুন"
      },
      "description": {
        "en": "Soak yellow and black mustard seeds for 20–30 minutes. Grind them with green chilies, turmeric, salt, and a little water into a smooth paste.",
        "bn": "হলুদ ও কালো সরিষা ২০–৩০ মিনিট ভিজিয়ে রাখুন। কাঁচা মরিচ, হলুদ, লবণ ও অল্প পানি দিয়ে মসৃণ বাটা তৈরি করুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Ilish into medium pieces. Rub with a little turmeric and salt. Keep aside for 10 minutes.",
        "bn": "ইলিশ মাছ পরিষ্কার করে মাঝারি টুকরো করুন। অল্প হলুদ ও লবণ মেখে ১০ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Lightly Fry the Fish",
        "bn": "মাছ হালকা ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan until it smokes lightly. Lightly fry the fish pieces on both sides for 1–2 minutes. Remove and set aside.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। মাছের টুকরোগুলো দুই পাশে ১–২ মিনিট হালকা ভেজে তুলে রাখুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Make the Mustard Gravy",
        "bn": "সরিষা ঝোল তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add nigella seeds. When they splutter, add the mustard paste and cook for 1–2 minutes on low heat. Add water, remaining salt, and slit green chilies. Bring to a gentle boil.",
        "bn": "একই তেলে কালোজিরা দিন। ফোড়ন উঠলে সরিষা বাটা দিয়ে কম আঁচে ১–২ মিনিট কষিয়ে নিন। পানি, বাকি লবণ ও চিরা কাঁচা মরিচ দিয়ে হালকা ফুটিয়ে তুলুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Fish and Finish",
        "bn": "মাছ দিয়ে শেষ করুন"
      },
      "description": {
        "en": "Gently place the fried fish pieces into the gravy. Cover and cook on low heat for 8–10 minutes until the fish is cooked and the gravy is light and aromatic. Do not stir too much.",
        "bn": "ভাজা মাছের টুকরোগুলো আলতো করে ঝোলে দিন। ঢাকনা দিয়ে কম আঁচে ৮–১০ মিনিট রান্না করুন যতক্ষণ না মাছ সেদ্ধ হয় এবং ঝোল হালকা ও সুগন্ধি হয়। বেশি নাড়বেন না।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve hot with steamed rice. This everyday Shorshe Jhol is light, flavorful, and comforting.",
        "bn": "গরম গরম ভাতের সাথে পরিবেশন করুন। এই দৈনন্দিন সরিষা ঝোল হালকা, স্বাদযুক্ত ও আরামদায়ক।"
      }
    }
  ],

  "tips": [
    {
      "en": "Keep the gravy thin and light — that is the characteristic of a good Shorshe Jhol.",
      "bn": "ঝোল হালকা ও পাতলা রাখুন — এটাই ভালো সরিষা ঝোলের বৈশিষ্ট্য।"
    },
    {
      "en": "Do not overcook the mustard paste on high heat, otherwise it can become bitter.",
      "bn": "সরিষা বাটা বেশি আঁচে বেশিক্ষণ কষাবেন না, নইলে তেতো হয়ে যেতে পারে।"
    },
    {
      "en": "A final drizzle of raw mustard oil before serving enhances the authentic aroma.",
      "bn": "পরিবেশনের আগে অল্প কাঁচা সরিষার তেল ছিটিয়ে দিলে আসল সুগন্ধ বাড়ে।"
    }
  ],

