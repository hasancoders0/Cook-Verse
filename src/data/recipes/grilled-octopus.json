  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Octopus",
        "bn": "অক্টোপাস প্রস্তুত করুন"
      },
      "description": {
        "en": "If frozen, thaw the octopus completely in the refrigerator. Rinse thoroughly under cold water and remove the beak if still present.",
        "bn": "জমে থাকলে ফ্রিজে গলিয়ে নিন। ঠান্ডা পানিতে ভালোভাবে ধুয়ে নিন এবং ঠোঁট থাকলে সরিয়ে ফেলুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Boil Until Tender",
        "bn": "নরম হওয়া পর্যন্ত সিদ্ধ করুন"
      },
      "description": {
        "en": "Place the octopus in a large pot with enough water to cover. Add bay leaves, lemon slices, and salt. Bring to a boil, then reduce to a gentle simmer. Cook for 45–60 minutes until a knife inserts easily into the thickest part.",
        "bn": "অক্টোপাস বড় হাঁড়িতে পানিতে ডুবিয়ে রাখুন। তেজপাতা, লেবুর স্লাইস ও লবণ দিন। ফুটিয়ে নামিয়ে কম আঁচে ৪৫–৬০ মিনিট সিদ্ধ করুন যতক্ষণ না ছুরি সহজে ঢোকে।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Cool and Cut",
        "bn": "ঠান্ডা করে কাটুন"
      },
      "description": {
        "en": "Remove the octopus from the water and let it cool slightly. Separate the tentacles and pat dry with paper towels.",
        "bn": "পানি থেকে তুলে হালকা ঠান্ডা হতে দিন। টেন্টাকল আলাদা করে কাগজের টাওয়েল দিয়ে শুকিয়ে নিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Marinate",
        "bn": "মেরিনেট করুন"
      },
      "description": {
        "en": "In a bowl, mix olive oil, lemon juice, minced garlic, oregano, black pepper, and half of the parsley. Toss the tentacles in the marinade and let sit for 10–15 minutes.",
        "bn": "বাটিতে অলিভ অয়েল, লেবুর রস, কুচি রসুন, ওরেগানো, গোলমরিচ ও অর্ধেক পার্সলে মিশিয়ে নিন। টেন্টাকলগুলো মেরিনেডে মাখিয়ে ১০–১৫ মিনিট রাখুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Grill",
        "bn": "গ্রিল করুন"
      },
      "description": {
        "en": "Preheat a grill or grill pan to medium-high heat. Grill the tentacles for 3–4 minutes per side until lightly charred and heated through.",
        "bn": "গ্রিল বা গ্রিল প্যান মিডিয়াম-হাই হিটে গরম করুন। টেন্টাকলগুলো প্রতি পাশে ৩–৪ মিনিট করে গ্রিল করুন যতক্ষণ না হালকা চার হয়।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Transfer to a serving plate. Drizzle with remaining marinade or extra olive oil and lemon juice. Sprinkle with the rest of the parsley and serve with lemon wedges.",
        "bn": "পরিবেশন প্লেটে তুলুন। বাকি মেরিনেড বা অতিরিক্ত অলিভ অয়েল ও লেবুর রস ছিটিয়ে দিন। বাকি পার্সলে ছিটিয়ে লেবুর টুকরো দিয়ে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Do not overcook on the grill — the octopus is already tender from boiling; you only want a light char.",
      "bn": "গ্রিলে অতিরিক্ত রান্না করবেন না — সিদ্ধ করার সময়ই নরম হয়ে যায়, শুধু হালকা চার লাগাতে হবে।"
    },
    {
      "en": "For extra tenderness, you can freeze the octopus overnight before cooking (the ice crystals help break down the fibers).",
      "bn": "অতিরিক্ত নরম করতে চাইলে রান্নার আগে এক রাত ফ্রিজে রাখতে পারেন (বরফের স্ফটিক মাংস নরম করে)।"
    },
    {
      "en": "Serve with grilled vegetables, roasted potatoes, or a simple Greek salad for a complete Mediterranean meal.",
      "bn": "সম্পূর্ণ ভূমধ্যসাগরীয় খাবারের জন্য গ্রিল করা সবজি, রোস্ট পটেটো বা সাধারণ গ্রীক সালাদের সাথে পরিবেশন করুন।"
    }
  ],

