  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Marinate the Fish",
        "bn": "মাছ মেরিনেট করুন"
      },
      "description": {
        "en": "Rub the fish pieces with a little turmeric, salt, and a pinch of chili powder. Set aside for 10–15 minutes.",
        "bn": "মাছের টুকরোগুলোতে অল্প হলুদ, লবণ ও এক চিমটি মরিচের গুঁড়া মেখে ১০–১৫ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভেজে নিন"
      },
      "description": {
        "en": "Heat oil in a pan. Lightly fry the fish pieces until golden on both sides. Remove and keep aside.",
        "bn": "প্যানে তেল গরম করে মাছের টুকরোগুলো দুই পাশে সোনালি করে হালকা ভেজে তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Prepare the Bhuna Base",
        "bn": "ভুনার বেস তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add the sliced onions and fry until golden brown. Add ginger-garlic paste and sauté until the raw smell disappears.",
        "bn": "একই তেলে পেঁয়াজ কুচি দিয়ে সোনালি করে ভাজুন। আদা-রসুন বাটা দিয়ে কাঁচা গন্ধ না যাওয়া পর্যন্ত কষিয়ে নিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Spices",
        "bn": "মসলা যোগ করুন"
      },
      "description": {
        "en": "Add turmeric, chili powder, cumin powder, coriander powder, and salt. Sprinkle a little water and cook the spices on medium heat until the oil separates (bhuna stage).",
        "bn": "হলুদ, মরিচ, জিরা, ধনিয়ার গুঁড়া ও লবণ দিন। অল্প পানি ছিটিয়ে মিডিয়াম আঁচে তেল উপরে ভেসে না আসা পর্যন্ত কষিয়ে নিন (ভুনা স্টেজ)।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Cook the Fish",
        "bn": "মাছ রান্না করুন"
      },
      "description": {
        "en": "Add the fried fish pieces and green chilies. Gently mix so the spices coat the fish. Cover and cook on low heat for 8–10 minutes, adding a splash of water only if needed.",
        "bn": "ভাজা মাছ ও কাঁচা মরিচ দিন। আলতো করে মিশিয়ে মসলা মাছের সাথে লেগে যায়। ঢাকনা দিয়ে কম আঁচে ৮–১০ মিনিট রান্না করুন, প্রয়োজনে অল্প পানি দিন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Finish & Serve",
        "bn": "শেষ করুন ও পরিবেশন করুন"
      },
      "description": {
        "en": "When the gravy is thick and oil floats on top, sprinkle chopped coriander leaves. Serve hot with steamed rice or plain roti.",
        "bn": "ঝোল ঘন হয়ে তেল উপরে ভেসে এলে ধনেপাতা কুচি ছিটিয়ে দিন। গরম গরম ভাত বা রুটির সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Do not over-stir the fish after adding it — Ayer fish is delicate and can break easily.",
      "bn": "মাছ দেওয়ার পর বেশি নেড়েচড়ে দেবেন না — আইড় মাছ নরম, সহজে ভেঙে যায়।"
    },
    {
      "en": "Mustard oil gives the authentic Bangladeshi flavor; heat it until it smokes lightly before cooking.",
      "bn": "সরিষার তেল আসল বাংলাদেশি স্বাদ দেয়; রান্নার আগে হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন।"
    },
    {
      "en": "For a drier bhuna, cook uncovered in the last few minutes so excess moisture evaporates.",
      "bn": "আরও শুকনো ভুনা চাইলে শেষ কয়েক মিনিট ঢাকনা খুলে রাখুন যাতে অতিরিক্ত পানি শুকিয়ে যায়।"
    }
  ],

