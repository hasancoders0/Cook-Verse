  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Ilish into medium pieces. Rub with a little turmeric and salt. Keep aside for 10 minutes.",
        "bn": "ইলিশ মাছ পরিষ্কার করে মাঝারি টুকরো করুন। অল্প হলুদ ও লবণ মেখে ১০ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Prepare the Tamarind",
        "bn": "তেঁতুল প্রস্তুত করুন"
      },
      "description": {
        "en": "Soak the tamarind in warm water for 10–15 minutes, then extract the thick pulp. Strain and keep aside. (If using raw mango, make a paste.)",
        "bn": "তেঁতুল গরম পানিতে ১০–১৫ মিনিট ভিজিয়ে মোটা মজ্জা বের করে ছেঁকে নিন। (কাঁচা আম ব্যবহার করলে বাটা করে নিন।)"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Fry the Fish Lightly",
        "bn": "মাছ হালকা ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan until it smokes lightly. Lightly fry the fish pieces on both sides for 1–2 minutes. Remove and set aside.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। মাছের টুকরোগুলো দুই পাশে ১–২ মিনিট হালকা ভেজে তুলে রাখুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Temper the Oil",
        "bn": "তেলে ফোড়ন দিন"
      },
      "description": {
        "en": "In the same oil, add mustard seeds and nigella seeds. When they splutter, add sliced onion (if using) and green chilies. Sauté briefly.",
        "bn": "একই তেলে সরিষা দানা ও কালোজিরা দিন। ফোড়ন উঠলে পেঁয়াজ কুচি (দিলে) ও কাঁচা মরিচ দিয়ে হালকা কষিয়ে নিন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Make the Tok Gravy",
        "bn": "টক ঝোল তৈরি করুন"
      },
      "description": {
        "en": "Add turmeric powder, the tamarind pulp, salt, sugar, and water. Bring to a boil and let it simmer for 3–4 minutes until the gravy becomes light and tangy.",
        "bn": "হলুদের গুঁড়া, তেঁতুলের মজ্জা, লবণ, চিনি ও পানি দিন। ফুটিয়ে ৩–৪ মিনিট সিদ্ধ করুন যতক্ষণ না ঝোল হালকা ও টক হয়।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Add Fish and Finish",
        "bn": "মাছ দিয়ে শেষ করুন"
      },
      "description": {
        "en": "Gently place the fried fish pieces into the gravy. Cover and cook on low heat for 6–8 minutes. Do not stir too much. Serve hot with steamed rice.",
        "bn": "ভাজা মাছের টুকরোগুলো আলতো করে ঝোলে দিন। ঢাকনা দিয়ে কম আঁচে ৬–৮ মিনিট রান্না করুন। বেশি নাড়বেন না। গরম গরম ভাতের সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "The gravy should remain thin and light — this is the charm of a good Tok.",
      "bn": "ঝোল হালকা ও পাতলা রাখুন — এটাই ভালো টকের সৌন্দর্য।"
    },
    {
      "en": "Adjust the sugar according to the sourness of the tamarind or raw mango.",
      "bn": "তেঁতুল বা কাঁচা আমের টক অনুযায়ী চিনির পরিমাণ ঠিক করুন।"
    },
    {
      "en": "Ilish Tok is especially popular in summer because the tangy gravy feels cooling and light.",
      "bn": "ইলিশ টক গ্রীষ্মকালে বিশেষ জনপ্রিয় কারণ টক ঝোল হালকা ও শীতল অনুভূতি দেয়।"
    }
  ],

