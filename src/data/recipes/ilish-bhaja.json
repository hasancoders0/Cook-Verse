  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Clean and Cut the Fish",
        "bn": "মাছ পরিষ্কার ও কাটুন"
      },
      "description": {
        "en": "Clean the Ilish thoroughly and cut into medium-sized pieces. Pat dry with a paper towel to remove excess moisture.",
        "bn": "ইলিশ মাছ ভালোভাবে পরিষ্কার করে মাঝারি আকারের টুকরো করুন। অতিরিক্ত পানি শুকানোর জন্য কাগজের টাওয়েল দিয়ে মুছে নিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Marinate",
        "bn": "মেরিনেট করুন"
      },
      "description": {
        "en": "Rub the fish pieces evenly with turmeric powder, salt, and red chili powder (if using). Let it rest for 10–15 minutes.",
        "bn": "মাছের টুকরোগুলোতে হলুদের গুঁড়া, লবণ এবং লাল মরিচের গুঁড়া (দিলে) সমানভাবে মেখে ১০–১৫ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Heat the Oil",
        "bn": "তেল গরম করুন"
      },
      "description": {
        "en": "Heat mustard oil in a frying pan over medium heat until it reaches smoking point, then reduce the heat slightly. This removes the raw smell of mustard oil.",
        "bn": "ফ্রাইং প্যানে সরিষার তেল মিডিয়াম আঁচে গরম করুন যতক্ষণ না ধোঁয়া বের হয়, তারপর আঁচ একটু কমিয়ে দিন। এতে সরিষার তেলের কাঁচা গন্ধ চলে যায়।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভাজুন"
      },
      "description": {
        "en": "Gently place the marinated fish pieces in the hot oil. Fry on medium heat for 3–4 minutes on each side until golden brown and crispy. Do not overcrowd the pan.",
        "bn": "মেরিনেট করা মাছের টুকরোগুলো গরম তেলে আলতো করে দিন। মিডিয়াম আঁচে প্রতি পাশে ৩–৪ মিনিট করে সোনালি ও ক্রিস্পি হওয়া পর্যন্ত ভাজুন। প্যানে একসাথে বেশি টুকরো দেবেন না।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Drain and Serve",
        "bn": "ঝরিয়ে পরিবেশন করুন"
      },
      "description": {
        "en": "Remove the fried fish and place on a paper towel to drain excess oil. Serve hot with steamed rice, dal, or any simple vegetable dish.",
        "bn": "ভাজা মাছ তুলে কাগজের টাওয়েলে রেখে অতিরিক্ত তেল ঝরিয়ে নিন। গরম গরম ভাত, ডাল বা যেকোনো সাধারণ তরকারির সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Pat the fish completely dry before marinating — this helps achieve a crispier crust.",
      "bn": "মেরিনেট করার আগে মাছ সম্পূর্ণ শুকিয়ে নিন — এতে ক্রিস্পিয়া ক্রাস্ট ভালো হয়।"
    },
    {
      "en": "Do not flip the fish too early or too often; let one side set properly before turning.",
      "bn": "মাছ খুব তাড়াতাড়ি বা বারবার উল্টাবেন না; এক পাশ ভালোভাবে সেট হওয়ার পর উল্টান।"
    },
    {
      "en": "Mustard oil is essential for authentic Bangladeshi flavor. Heat it properly until it smokes.",
      "bn": "আসল বাংলাদেশি স্বাদের জন্য সরিষার তেল জরুরি। সঠিকভাবে ধোঁয়া বের হওয়া পর্যন্ত গরম করুন।"
    }
  ],

