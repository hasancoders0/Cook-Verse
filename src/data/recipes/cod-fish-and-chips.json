  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Chips",
        "bn": "চিপস প্রস্তুত করুন"
      },
      "description": {
        "en": "Peel the potatoes and cut into thick chips (about 1.5 cm). Rinse in cold water to remove excess starch, then pat completely dry.",
        "bn": "আলু ছাড়িয়ে মোটা চিপস (প্রায় ১.৫ সেমি) কেটে নিন। অতিরিক্ত স্টার্চ সরাতে ঠান্ডা পানিতে ধুয়ে সম্পূর্ণ শুকিয়ে নিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "First Fry the Chips",
        "bn": "চিপস প্রথমবার ভাজুন"
      },
      "description": {
        "en": "Heat oil to 150°C (300°F). Fry the chips in batches for 5–6 minutes until soft but not colored. Remove and drain on paper towels.",
        "bn": "তেল ১৫০°C (৩০০°F) গরম করুন। চিপস ব্যাচ করে ৫–৬ মিনিট ভাজুন যতক্ষণ না নরম হয় কিন্তু রং না ধরে। তুলে কাগজের টাওয়েলে ঝরিয়ে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Make the Batter",
        "bn": "ব্যাটার তৈরি করুন"
      },
      "description": {
        "en": "In a large bowl, whisk together flour, cornflour, baking powder, and salt. Gradually whisk in the ice-cold beer until you get a smooth, thick batter (like double cream). Keep cold.",
        "bn": "বড় বাটিতে ময়দা, কর্নফ্লোর, বেকিং পাউডার ও লবণ মিশিয়ে ফেটিয়ে নিন। ধীরে ধীরে বরফ ঠান্ডা বিয়ার দিয়ে মসৃণ ঘন ব্যাটার (ডাবল ক্রিমের মতো) তৈরি করুন। ঠান্ডা রাখুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Pat the cod fillets completely dry. Season lightly with salt. Dust with a little flour so the batter sticks better.",
        "bn": "কড ফিলেট সম্পূর্ণ শুকিয়ে নিন। হালকা লবণ ছিটিয়ে দিন। ব্যাটার ভালোভাবে লাগার জন্য অল্প ময়দা মাখিয়ে নিন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভাজুন"
      },
      "description": {
        "en": "Increase oil temperature to 180°C (350°F). Dip each fish piece into the cold batter, let excess drip off, and carefully lower into the hot oil. Fry for 5–7 minutes until golden and crispy. Drain on a wire rack.",
        "bn": "তেলের তাপমাত্রা ১৮০°C (৩৫০°F) বাড়ান। প্রতিটি মাছের টুকরো ঠান্ডা ব্যাটারে ডুবিয়ে অতিরিক্ত ব্যাটার ঝরিয়ে গরম তেলে সাবধানে নামান। ৫–৭ মিনিট সোনালি ও ক্রিস্পি হওয়া পর্যন্ত ভাজুন। তারের র্যাকে ঝরিয়ে রাখুন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Second Fry the Chips & Serve",
        "bn": "চিপস দ্বিতীয়বার ভাজুন ও পরিবেশন করুন"
      },
      "description": {
        "en": "Raise oil to 190°C (375°F). Fry the chips again for 2–3 minutes until golden and crisp. Season with salt. Serve the fish and chips immediately with malt vinegar.",
        "bn": "তেল ১৯০°C (৩৭৫°F) গরম করুন। চিপস আবার ২–৩ মিনিট সোনালি ও ক্রিস্পি হওয়া পর্যন্ত ভাজুন। লবণ ছিটিয়ে দিন। মাছ ও চিপস সাথে সাথে মল্ট ভিনেগার দিয়ে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Keep the batter ice-cold and the oil hot — this creates the lightest, crispiest coating.",
      "bn": "ব্যাটার বরফ ঠান্ডা এবং তেল গরম রাখুন — এতে সবচেয়ে হালকা ও ক্রিস্পি কোট হয়।"
    },
    {
      "en": "Double-frying the chips is essential for the perfect British-style texture.",
      "bn": "চিপস দুইবার ভাজা আসল ব্রিটিশ স্টাইলের টেক্সচারের জন্য জরুরি।"
    },
    {
      "en": "Serve immediately — fish and chips are best eaten fresh and hot.",
      "bn": "সাথে সাথে পরিবেশন করুন — ফিশ অ্যান্ড চিপস তাজা ও গরম অবস্থায় সবচেয়ে ভালো।"
    }
  ],

