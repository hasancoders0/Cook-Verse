  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Vegetables",
        "bn": "সবজি প্রস্তুত করুন"
      },
      "description": {
        "en": "Wash all vegetables thoroughly under cold water. Chop the lettuce into bite-sized pieces, slice the cucumber, dice the tomatoes, grate or julienne the carrot, and thinly slice the red onion.",
        "bn": "সবজি ঠান্ডা পানিতে ভালোভাবে ধুয়ে নিন। লেটুস কামড়ের আকারে কুচি করুন, শসা স্লাইস করুন, টমেটো কিউব করুন, গাজর কুঁচি বা জুলিয়েন করুন এবং লাল পেঁয়াজ পাতলা করে কাটুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Combine the Vegetables",
        "bn": "সবজি একসাথে মেশান"
      },
      "description": {
        "en": "Place all the prepared vegetables into a large mixing bowl.",
        "bn": "সব প্রস্তুত করা সবজি একটি বড় মিক্সিং বোলে নিন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Prepare the Dressing",
        "bn": "ড্রেসিং তৈরি করুন"
      },
      "description": {
        "en": "In a small bowl, whisk together the olive oil, lemon juice, salt, and black pepper until well combined and slightly emulsified.",
        "bn": "একটি ছোট বাটিতে অলিভ অয়েল, লেবুর রস, লবণ এবং গোলমরিচ একসাথে ভালোভাবে ফেটিয়ে ড্রেসিং তৈরি করুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Dress the Salad",
        "bn": "সালাদে ড্রেসিং মেশান"
      },
      "description": {
        "en": "Pour the dressing over the vegetables and toss gently until everything is evenly coated. Taste and adjust salt or lemon if needed.",
        "bn": "সবজির উপর ড্রেসিং ঢেলে আলতোভাবে মিশিয়ে নিন যাতে সবজিগুলো সমানভাবে কোট হয়। স্বাদ দেখে প্রয়োজনে লবণ বা লেবু বাড়ান।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve immediately while the vegetables are still crisp and fresh.",
        "bn": "সবজি সতেজ ও মচমচে থাকা অবস্থায় সঙ্গে সঙ্গে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Chill the chopped vegetables in the fridge for 10–15 minutes before dressing for extra crispness.",
      "bn": "ড্রেসিং দেওয়ার আগে কাটা সবজি ১০–১৫ মিনিট ফ্রিজে রেখে আরও মচমচে করুন।"
    },
    {
      "en": "Add crumbled feta, avocado slices, or a handful of chickpeas for extra protein and flavor.",
      "bn": "অতিরিক্ত প্রোটিন ও স্বাদের জন্য ফেটা চিজ, অ্যাভোকাডো স্লাইস বা কিছু ছোলা যোগ করতে পারেন।"
    },
    {
      "en": "Keep the dressing separate and toss just before serving so the salad stays crisp longer.",
      "bn": "ড্রেসিং আলাদা রেখে পরিবেশনের ঠিক আগে মেশান যাতে সালাদ বেশিক্ষণ মচমচে থাকে।"
    }
  ],

