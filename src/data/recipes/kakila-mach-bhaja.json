  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Clean the Fish",
        "bn": "মাছ পরিষ্কার করুন"
      },
      "description": {
        "en": "Clean the Kakila fish thoroughly. Remove the guts if not already cleaned. Wash well and pat dry with a paper towel.",
        "bn": "কাকিলা মাছ ভালোভাবে পরিষ্কার করুন। না পরিষ্কার করা থাকলে নাড়িভুঁড়ি বের করে ফেলুন। ভালো করে ধুয়ে কাগজের টাওয়েল দিয়ে শুকিয়ে নিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Marinate",
        "bn": "মেরিনেট করুন"
      },
      "description": {
        "en": "Rub the fish evenly with turmeric powder, salt, and red chili powder (if using). Let it rest for 10 minutes.",
        "bn": "মাছে হলুদের গুঁড়া, লবণ এবং লাল মরিচের গুঁড়া (দিলে) সমানভাবে মেখে ১০ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Heat the Oil",
        "bn": "তেল গরম করুন"
      },
      "description": {
        "en": "Heat mustard oil in a frying pan over medium heat until it reaches smoking point, then reduce the heat slightly.",
        "bn": "ফ্রাইং প্যানে সরিষার তেল মিডিয়াম আঁচে গরম করুন যতক্ষণ না ধোঁয়া বের হয়, তারপর আঁচ একটু কমিয়ে দিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভাজুন"
      },
      "description": {
        "en": "Gently place the marinated Kakila fish in the hot oil. Fry on medium heat for 3–4 minutes on each side until golden brown and crispy. Do not overcrowd the pan.",
        "bn": "মেরিনেট করা কাকিলা মাছ গরম তেলে আলতো করে দিন। মিডিয়াম আঁচে প্রতি পাশে ৩–৪ মিনিট করে সোনালি ও ক্রিস্পি হওয়া পর্যন্ত ভাজুন। প্যানে একসাথে বেশি মাছ দেবেন না।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Drain and Serve",
        "bn": "ঝরিয়ে পরিবেশন করুন"
      },
      "description": {
        "en": "Remove the fried fish and place on a paper towel to drain excess oil. Serve hot with steamed rice and dal or any simple vegetable dish.",
        "bn": "ভাজা মাছ তুলে কাগজের টাওয়েলে রেখে অতিরিক্ত তেল ঝরিয়ে নিন। গরম গরম ভাত, ডাল বা যেকোনো সাধারণ তরকারির সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Pat the fish completely dry before marinating for a crispier result.",
      "bn": "মেরিনেট করার আগে মাছ সম্পূর্ণ শুকিয়ে নিন যাতে আরও ক্রিস্পি হয়।"
    },
    {
      "en": "Fry on medium heat so the small fish cooks through without burning.",
      "bn": "মিডিয়াম আঁচে ভাজুন যাতে ছোট মাছ পুড়ে না যায় এবং ভিতর পর্যন্ত সেদ্ধ হয়।"
    },
    {
      "en": "Mustard oil gives the authentic Bangladeshi flavor — heat it properly until it smokes.",
      "bn": "সরিষার তেল আসল বাংলাদেশি স্বাদ দেয় — সঠিকভাবে ধোঁয়া বের হওয়া পর্যন্ত গরম করুন।"
    }
  ],

