  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Ayer fish into medium pieces. Rub with a little turmeric and salt. Keep aside for 10 minutes.",
        "bn": "আইড় মাছ পরিষ্কার করে মাঝারি টুকরো করুন। অল্প হলুদ ও লবণ মেখে ১০ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish Lightly",
        "bn": "মাছ হালকা ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan. Lightly fry the fish pieces for 1–2 minutes on each side until the surface firms up. Remove and set aside.",
        "bn": "সরিষার তেল গরম করে মাছের টুকরোগুলো প্রতি পাশে ১–২ মিনিট হালকা ভেজে নিন যতক্ষণ না উপরের অংশ শক্ত হয়। তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Make the Gravy Base",
        "bn": "ঝোলের বেস তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add sliced onion and fry until soft and light golden. Add ginger-garlic paste and sauté for a minute.",
        "bn": "একই তেলে পেঁয়াজ কুচি দিয়ে নরম ও হালকা সোনালি করে ভাজুন। আদা-রসুন বাটা দিয়ে এক মিনিট কষিয়ে নিন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Spices and Vegetables",
        "bn": "মসলা ও সবজি যোগ করুন"
      },
      "description": {
        "en": "Add turmeric, chili powder, cumin powder, and salt. Mix well. Add chopped tomato and potato pieces. Stir for 2–3 minutes.",
        "bn": "হলুদ, মরিচের গুঁড়া, জিরা গুঁড়া ও লবণ দিয়ে মিশিয়ে নিন। কুচি করা টমেটো ও আলুর টুকরো দিন। ২–৩ মিনিট নাড়ুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Water and Fish",
        "bn": "পানি ও মাছ দিন"
      },
      "description": {
        "en": "Pour in the water and bring to a boil. Gently add the fried fish pieces and green chilies. Cover and cook on medium-low heat for 12–15 minutes until the potatoes are soft and the gravy is light.",
        "bn": "পানি দিয়ে ফুটিয়ে তুলুন। ভাজা মাছের টুকরো ও কাঁচা মরিচ আলতো করে দিন। ঢাকনা দিয়ে মিডিয়াম-লো আঁচে ১২–১৫ মিনিট রান্না করুন যতক্ষণ না আলু নরম হয় এবং ঝোল হালকা হয়।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Finish and Serve",
        "bn": "শেষ করুন ও পরিবেশন করুন"
      },
      "description": {
        "en": "Check seasoning. Sprinkle chopped coriander leaves. Serve hot with steamed rice.",
        "bn": "স্বাদ দেখে নিন। ধনেপাতা কুচি ছিটিয়ে দিন। গরম গরম ভাতের সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Keep the gravy thin and light — that is the characteristic of a good Bengali/Bangladeshi jhol.",
      "bn": "ঝোল হালকা ও পাতলা রাখুন — এটাই ভালো বাংলা/বাংলাদেশি ঝোলের বৈশিষ্ট্য।"
    },
    {
      "en": "Do not over-fry the fish; just a light fry is enough so it doesn’t break while cooking in the gravy.",
      "bn": "মাছ বেশি ভাজবেন না; শুধু হালকা ভেজে নিলেই হবে যাতে ঝোলে রান্নার সময় না ভাঙে।"
    },
    {
      "en": "Adding a few mustard seeds or a pinch of panch phoron at the beginning gives extra traditional aroma.",
      "bn": "শুরুতে কয়েকটা সরিষা বা এক চিমটি পাঁচ ফোড়ন দিলে অতিরিক্ত ঐতিহ্যবাহী সুগন্ধ পাওয়া যায়।"
    }
  ],

