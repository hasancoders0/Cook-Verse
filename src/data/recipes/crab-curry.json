  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Crab",
        "bn": "কাঁকড়া প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean the crabs thoroughly. Remove the top shell, gills, and any unwanted parts. Cut into pieces if large. Wash well and keep aside.",
        "bn": "কাঁকড়া ভালোভাবে পরিষ্কার করুন। উপরের খোলস, গিল ও অপ্রয়োজনীয় অংশ সরিয়ে ফেলুন। বড় হলে টুকরো করুন। ভালো করে ধুয়ে রাখুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Make the Masala Base",
        "bn": "মসলার বেস তৈরি করুন"
      },
      "description": {
        "en": "Heat oil in a deep pan. Add sliced onions and fry until golden brown. Add ginger-garlic paste and green chilies. Sauté until the raw smell disappears.",
        "bn": "গভীর প্যানে তেল গরম করুন। পেঁয়াজ কুচি দিয়ে সোনালি করে ভাজুন। আদা-রসুন বাটা ও কাঁচা মরিচ দিয়ে কাঁচা গন্ধ না যাওয়া পর্যন্ত কষিয়ে নিন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Add Spices and Tomato",
        "bn": "মসলা ও টমেটো যোগ করুন"
      },
      "description": {
        "en": "Add turmeric, red chili powder, coriander powder, cumin powder, and salt. Mix well. Add chopped tomatoes and cook until soft and the oil starts to separate.",
        "bn": "হলুদ, লাল মরিচ, ধনিয়া, জিরা গুঁড়া ও লবণ দিয়ে মিশিয়ে নিন। কুচি করা টমেটো দিয়ে নরম হওয়া এবং তেল উপরে ভেসে না আসা পর্যন্ত রান্না করুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Coconut and Crab",
        "bn": "নারকেল ও কাঁকড়া যোগ করুন"
      },
      "description": {
        "en": "Add the grated coconut and stir for a minute. Then add the cleaned crab pieces. Mix gently so the masala coats the crab well. Cook for 3–4 minutes.",
        "bn": "কুচি করা নারকেল দিয়ে এক মিনিট নাড়ুন। তারপর পরিষ্কার করা কাঁকড়ার টুকরো দিন। আলতো করে মিশিয়ে মসলা কাঁকড়ায় ভালোভাবে লেগে যায়। ৩–৪ মিনিট রান্না করুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Simmer the Curry",
        "bn": "কারি সিদ্ধ করুন"
      },
      "description": {
        "en": "Pour in the water, cover, and cook on medium-low heat for 15–20 minutes until the crab is cooked and the gravy thickens slightly. Stir occasionally.",
        "bn": "পানি দিয়ে ঢাকনা দিয়ে মিডিয়াম-লো আঁচে ১৫–২০ মিনিট রান্না করুন যতক্ষণ না কাঁকড়া সেদ্ধ হয় এবং ঝোল একটু ঘন হয়। মাঝে মাঝে নাড়ুন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Finish and Serve",
        "bn": "শেষ করুন ও পরিবেশন করুন"
      },
      "description": {
        "en": "Sprinkle garam masala and chopped coriander. Simmer for another 2 minutes. Serve hot with steamed rice or appam. Ideal for special occasions.",
        "bn": "গরম মসলা ও ধনেপাতা কুচি ছিটিয়ে আরও ২ মিনিট সিদ্ধ করুন। গরম গরম ভাত বা অ্যাপামের সাথে পরিবেশন করুন। বিশেষ অনুষ্ঠানের জন্য আদর্শ।"
      }
    }
  ],

  "tips": [
    {
      "en": "Use fresh live crabs for the best flavor and texture.",
      "bn": "সেরা স্বাদ ও টেক্সচারের জন্য তাজা জীবিত কাঁকড়া ব্যবহার করুন।"
    },
    {
      "en": "Do not overcook the crab, otherwise the meat becomes tough.",
      "bn": "কাঁকড়া অতিরিক্ত রান্না করবেন না, নইলে মাংস শক্ত হয়ে যায়।"
    },
    {
      "en": "A little coconut milk can be added at the end for a richer, creamier gravy.",
      "bn": "শেষে অল্প নারকেলের দুধ দিলে ঝোল আরও সমৃদ্ধ ও ক্রিমি হয়।"
    }
  ],

