  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Rice",
        "bn": "চাল প্রস্তুত করুন"
      },
      "description": {
        "en": "Wash the basmati rice thoroughly until the water runs clear, then soak it for 30 minutes.",
        "bn": "বাসমতি চাল ভালোভাবে ধুয়ে পানি পরিষ্কার হওয়া পর্যন্ত ধুয়ে ৩০ মিনিট ভিজিয়ে রাখুন।"
      },
      "tip": {
        "en": "Soaking helps the rice cook evenly and remain fluffy.",
        "bn": "চাল ভিজিয়ে রাখলে সমানভাবে সেদ্ধ হয় এবং ঝরঝরে থাকে।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Marinate the Chicken",
        "bn": "মুরগি মেরিনেট করুন"
      },
      "description": {
        "en": "Mix the chicken with yogurt, ginger-garlic paste, lemon juice, turmeric, red chili powder, garam masala, and salt. Marinate for at least 30 minutes (or overnight for deeper flavor).",
        "bn": "মুরগির সাথে টক দই, আদা-রসুন বাটা, লেবুর রস, হলুদ, লাল মরিচের গুঁড়া, গরম মসলা ও লবণ মিশিয়ে কমপক্ষে ৩০ মিনিট মেরিনেট করুন (গভীর স্বাদের জন্য সারা রাত রাখতে পারেন)।"
      },
      "tip": {
        "en": "Overnight marination gives the best results.",
        "bn": "সারা রাত মেরিনেট করলে সেরা ফল পাওয়া যায়।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Parboil the Rice",
        "bn": "চাল আংশিক সেদ্ধ করুন"
      },
      "description": {
        "en": "Bring water to a boil with the whole spices and salt. Add the soaked rice and cook until it is about 70% done (grains should still have a firm core). Drain immediately and set aside.",
        "bn": "গোটা মসলা ও লবণ দিয়ে পানি ফুটিয়ে তাতে ভেজানো চাল দিন। চাল প্রায় ৭০% সেদ্ধ হওয়া পর্যন্ত রান্না করুন (দানায় একটু শক্ত অংশ থাকবে)। সঙ্গে সঙ্গে পানি ঝরিয়ে আলাদা রাখুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Cook the Chicken",
        "bn": "মুরগি রান্না করুন"
      },
      "description": {
        "en": "In a heavy-bottomed pot, cook the marinated chicken with sliced onions and chopped tomato until the chicken is tender and the masala thickens slightly.",
        "bn": "ভারী তলাযুক্ত পাত্রে মেরিনেট করা মুরগি, পাতলা কাটা পেঁয়াজ ও কুচি করা টমেটোর সাথে নরম হওয়া এবং মসলা একটু ঘন হওয়া পর্যন্ত রান্না করুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Layer the Biryani",
        "bn": "বিরিয়ানির স্তর তৈরি করুন"
      },
      "description": {
        "en": "In the same pot, layer half the chicken, then half the rice. Sprinkle fried onions, mint, coriander, saffron milk, and ghee. Repeat the layers. Finish with the remaining rice and garnish.",
        "bn": "একই পাত্রে অর্ধেক মুরগি, তারপর অর্ধেক চাল স্তরে সাজান। ভাজা পেঁয়াজ, পুদিনা, ধনেপাতা, জাফরান দুধ ও ঘি ছিটিয়ে দিন। স্তরগুলো পুনরাবৃত্তি করুন। শেষে বাকি চাল দিয়ে ঢেকে সাজিয়ে দিন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Dum Cooking",
        "bn": "দমে রান্না করুন"
      },
      "description": {
        "en": "Seal the pot tightly (with a lid or dough) and cook on the lowest heat for 20–25 minutes. Let it rest for 5–10 minutes before opening.",
        "bn": "পাত্র ভালোভাবে ঢেকে (ঢাকনা বা ময়দার ডো দিয়ে) সবচেয়ে কম আঁচে ২০–২৫ মিনিট দমে রান্না করুন। খোলার আগে ৫–১০ মিনিট বিশ্রাম দিন।"
      }
    },
    {
      "step": 7,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Gently fluff the biryani from the sides and serve hot with raita, salad, or boiled egg.",
        "bn": "পাশ থেকে হালকাভাবে বিরিয়ানি নেড়ে রায়তা, সালাদ বা সিদ্ধ ডিম দিয়ে গরম গরম পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Use aged basmati rice for the best texture and aroma.",
      "bn": "সেরা টেক্সচার ও সুগন্ধের জন্য পুরনো বাসমতি চাল ব্যবহার করুন।"
    },
    {
      "en": "Never fully cook the rice before layering — 70% is ideal.",
      "bn": "স্তর তৈরির আগে চাল পুরোপুরি সেদ্ধ করবেন না — ৭০% আদর্শ।"
    },
    {
      "en": "Low and slow dum heat is the secret to authentic biryani.",
      "bn": "আসল বিরিয়ানির গোপন রহস্য হলো কম আঁচে ধীরে ধীরে দম দেওয়া।"
    }
  ],

