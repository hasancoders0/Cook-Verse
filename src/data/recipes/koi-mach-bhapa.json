  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Mustard Paste",
        "bn": "সরিষা বাটা তৈরি করুন"
      },
      "description": {
        "en": "Soak the yellow and black mustard seeds for 20–30 minutes. Grind them with green chilies, turmeric, salt, and a little water into a smooth, thick paste. Mix in the mustard oil.",
        "bn": "হলুদ ও কালো সরিষা ২০–৩০ মিনিট ভিজিয়ে রাখুন। কাঁচা মরিচ, হলুদ, লবণ ও অল্প পানি দিয়ে মসৃণ ঘন বাটা তৈরি করুন। সরিষার তেল মিশিয়ে নিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Prepare and Marinate the Fish",
        "bn": "মাছ প্রস্তুত ও মেরিনেট করুন"
      },
      "description": {
        "en": "Clean the Koi fish thoroughly, score the skin, and pat dry. Coat each fish (or pieces) generously with the mustard paste. Let it marinate for at least 15–20 minutes.",
        "bn": "কই মাছ ভালোভাবে পরিষ্কার করে চামড়ায় স্কোর দিন এবং শুকিয়ে নিন। প্রতিটি মাছে (বা টুকরোতে) সরিষা বাটা ভালোভাবে মাখিয়ে কমপক্ষে ১৫–২০ মিনিট মেরিনেট করুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Arrange for Steaming",
        "bn": "ভাপানোর জন্য সাজান"
      },
      "description": {
        "en": "Place the marinated fish in a heat-proof bowl or steel container. Pour any remaining paste over them and place a few extra green chilies on top.",
        "bn": "মেরিনেট করা মাছ তাপসহনীয় বাটি বা স্টিলের পাত্রে সাজান। বাকি বাটা উপরে ঢেলে দিন এবং কয়েকটি অতিরিক্ত কাঁচা মরিচ রাখুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Steam the Fish",
        "bn": "মাছ ভাপুন"
      },
      "description": {
        "en": "Place the bowl in a steamer or inside a large pot with a little water at the bottom. Cover tightly and steam on medium heat for 20–25 minutes until the fish is cooked and the oil separates from the paste.",
        "bn": "বাটিটি স্টিমারে বা অল্প পানি দেওয়া বড় হাঁড়ির ভিতরে রাখুন। ভালোভাবে ঢেকে মিডিয়াম আঁচে ২০–২৫ মিনিট ভাপুন যতক্ষণ না মাছ সেদ্ধ হয় এবং বাটা থেকে তেল আলাদা হয়।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Rest and Serve",
        "bn": "বিশ্রাম দিয়ে পরিবেশন করুন"
      },
      "description": {
        "en": "Turn off the heat and let it rest for 5 minutes. Serve hot directly from the bowl with steamed rice. Ideal for guest meals.",
        "bn": "আঁচ বন্ধ করে ৫ মিনিট বিশ্রাম দিন। বাটি থেকেই গরম গরম ভাতের সাথে পরিবেশন করুন। অতিথি আপ্যায়নের জন্য আদর্শ।"
      }
    }
  ],

  "tips": [
    {
      "en": "Scoring the skin of Koi fish helps the mustard paste penetrate better and cooks more evenly.",
      "bn": "কই মাছের চামড়ায় স্কোর দিলে সরিষা বাটা ভালোভাবে ঢোকে এবং সমানভাবে সেদ্ধ হয়।"
    },
    {
      "en": "The mustard paste should be thick so it clings well to the fish.",
      "bn": "সরিষা বাটা ঘন হওয়া উচিত যাতে মাছের সাথে ভালোভাবে লেগে থাকে।"
    },
    {
      "en": "Keep the lid closed while steaming to trap the aroma and moisture.",
      "bn": "ভাপানোর সময় ঢাকনা বন্ধ রাখুন যাতে সুগন্ধ ও আর্দ্রতা আটকে থাকে।"
    }
  ],

