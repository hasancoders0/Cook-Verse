  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean and cut the Ilish into thick pieces. Rub with turmeric and salt. Keep aside for 15 minutes.",
        "bn": "ইলিশ মাছ পরিষ্কার করে মোটা টুকরো করুন। হলুদ ও লবণ মেখে ১৫ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Fish",
        "bn": "মাছ ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan until it smokes lightly. Fry the fish pieces carefully on both sides until light golden. Remove and set aside.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। মাছের টুকরোগুলো সাবধানে দুই পাশে হালকা সোনালি করে ভেজে তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Make the Onion Base",
        "bn": "পেঁয়াজের বেস তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add bay leaf, cinnamon, cardamom, and cloves. Add sliced onions and fry until deep golden brown. This is the key to a good kalia.",
        "bn": "একই তেলে তেজপাতা, দারুচিনি, এলাচ ও লবঙ্গ দিন। পেঁয়াজ কুচি দিয়ে গাঢ় সোনালি করে ভাজুন। ভালো কালিয়ার জন্য এটা খুব জরুরি।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Cook the Spices",
        "bn": "মসলা কষিয়ে নিন"
      },
      "description": {
        "en": "Add ginger-garlic paste and sauté. Then add turmeric, chili powder, cumin, coriander powder, and beaten yogurt. Cook on medium heat until the oil separates and the masala becomes thick and aromatic.",
        "bn": "আদা-রসুন বাটা দিয়ে কষিয়ে নিন। তারপর হলুদ, মরিচ, জিরা, ধনিয়ার গুঁড়া ও ফেটানো দই দিন। মিডিয়াম আঁচে তেল উপরে ভেসে না আসা এবং মসলা ঘন ও সুগন্ধি হওয়া পর্যন্ত কষান।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Add Fish and Finish",
        "bn": "মাছ দিয়ে শেষ করুন"
      },
      "description": {
        "en": "Gently add the fried fish pieces and green chilies. Add a little warm water if needed for gravy. Cover and cook on low heat for 8–10 minutes. Finish with garam masala, ghee, and chopped coriander.",
        "bn": "ভাজা মাছের টুকরো ও কাঁচা মরিচ আলতো করে দিন। প্রয়োজনে অল্প গরম পানি দিন। ঢাকনা দিয়ে কম আঁচে ৮–১০ মিনিট রান্না করুন। শেষে গরম মসলা, ঘি ও ধনেপাতা কুচি দিয়ে সাজান।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve hot with steamed rice or polao. This rich kalia is best enjoyed on special occasions.",
        "bn": "গরম গরম ভাত বা পোলাওয়ের সাথে পরিবেশন করুন। এই সমৃদ্ধ কালিয়া বিশেষ অনুষ্ঠানে সবচেয়ে ভালো লাগে।"
      }
    }
  ],

  "tips": [
    {
      "en": "Never over-stir Ilish after adding it to the gravy — the pieces are delicate and can break easily.",
      "bn": "ইলিশ মাছ ঝোলে দেওয়ার পর বেশি নেড়েচড়ে দেবেন না — টুকরোগুলো নরম, সহজে ভেঙে যায়।"
    },
    {
      "en": "Deep golden onions are the secret to authentic kalia color and flavor.",
      "bn": "গাঢ় সোনালি পেঁয়াজই আসল কালিয়ার রং ও স্বাদের গোপন রহস্য।"
    },
    {
      "en": "Use good quality mustard oil and heat it properly for the classic Bangladeshi aroma.",
      "bn": "ভালো মানের সরিষার তেল ব্যবহার করুন এবং সঠিকভাবে গরম করুন যাতে ঐতিহ্যবাহী বাংলাদেশি সুগন্ধ আসে।"
    }
  ],

