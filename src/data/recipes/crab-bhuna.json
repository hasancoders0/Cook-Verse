  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Crab",
        "bn": "কাঁকড়া প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean the crabs thoroughly. Remove the top shell, gills, and unwanted parts. Cut into pieces if large. Wash well and keep aside.",
        "bn": "কাঁকড়া ভালোভাবে পরিষ্কার করুন। উপরের খোলস, গিল ও অপ্রয়োজনীয় অংশ সরিয়ে ফেলুন। বড় হলে টুকরো করুন। ভালো করে ধুয়ে রাখুন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Fry the Onions",
        "bn": "পেঁয়াজ ভাজুন"
      },
      "description": {
        "en": "Heat mustard oil in a deep pan until it smokes lightly. Add the thinly sliced onions and fry on medium heat until soft and golden brown.",
        "bn": "সরিষার তেল হালকা ধোঁয়া বের হওয়া পর্যন্ত গরম করুন। পাতলা কাটা পেঁয়াজ দিয়ে মিডিয়াম আঁচে নরম ও সোনালি বাদামি করে ভাজুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Cook the Masala",
        "bn": "মসলা কষিয়ে নিন"
      },
      "description": {
        "en": "Add ginger-garlic paste and green chilies. Sauté until the raw smell disappears. Then add turmeric, red chili powder, cumin powder, coriander powder, and salt. Sprinkle a little water and cook until the oil separates.",
        "bn": "আদা-রসুন বাটা ও কাঁচা মরিচ দিয়ে কাঁচা গন্ধ না যাওয়া পর্যন্ত কষিয়ে নিন। তারপর হলুদ, লাল মরিচ, জিরা, ধনিয়ার গুঁড়া ও লবণ দিন। অল্প পানি ছিটিয়ে তেল উপরে ভেসে না আসা পর্যন্ত কষান।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Tomato and Crab",
        "bn": "টমেটো ও কাঁকড়া যোগ করুন"
      },
      "description": {
        "en": "Add chopped tomatoes and cook until soft. Then add the cleaned crab pieces. Mix gently so the masala coats the crab well. Cook for 4–5 minutes on medium heat.",
        "bn": "কুচি করা টমেটো দিয়ে নরম হওয়া পর্যন্ত রান্না করুন। তারপর পরিষ্কার করা কাঁকড়ার টুকরো দিন। আলতো করে মিশিয়ে মসলা কাঁকড়ায় ভালোভাবে লেগে যায়। মিডিয়াম আঁচে ৪–৫ মিনিট রান্না করুন।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Bhuna and Finish",
        "bn": "ভুনা করে শেষ করুন"
      },
      "description": {
        "en": "Cover and cook on low heat for 12–15 minutes until the crab is fully cooked and the gravy becomes thick with oil floating on top. Sprinkle garam masala and chopped coriander. Mix gently.",
        "bn": "ঢাকনা দিয়ে কম আঁচে ১২–১৫ মিনিট রান্না করুন যতক্ষণ না কাঁকড়া সেদ্ধ হয় এবং ঝোল ঘন হয়ে তেল উপরে ভেসে ওঠে। গরম মসলা ও ধনেপাতা কুচি ছিটিয়ে আলতো করে মিশিয়ে নিন।"
      }
    },
    {
      "step": 6,
      "title": {
        "en": "Serve",
        "bn": "পরিবেশন করুন"
      },
      "description": {
        "en": "Serve hot with steamed rice. This rich Crab Bhuna is ideal for special occasion meals at lunch or dinner.",
        "bn": "গরম গরম ভাতের সাথে পরিবেশন করুন। এই সমৃদ্ধ কাঁকড়া ভুনা বিশেষ অনুষ্ঠানের দুপুর বা রাতের খাবারের জন্য আদর্শ।"
      }
    }
  ],

  "tips": [
    {
      "en": "Use fresh crabs for the best flavor. Frozen crabs can be used but fresh is always better.",
      "bn": "সেরা স্বাদের জন্য তাজা কাঁকড়া ব্যবহার করুন। জমে থাকা কাঁকড়াও ব্যবহার করা যায় তবে তাজাই ভালো।"
    },
    {
      "en": "Proper bhuna (cooking until oil separates) is the key to authentic taste and rich color.",
      "bn": "সঠিক ভুনা (তেল উপরে ভেসে না আসা পর্যন্ত কষানো) আসল স্বাদ ও গাঢ় রঙের চাবিকাঠি।"
    },
    {
      "en": "Do not add too much water — Crab Bhuna should have a thick, semi-dry consistency.",
      "bn": "বেশি পানি দেবেন না — কাঁকড়া ভুনা ঘন ও অর্ধ-শুকনো হওয়া উচিত।"
    }
  ],

