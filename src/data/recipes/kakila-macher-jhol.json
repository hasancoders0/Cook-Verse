  "instructions": [
    {
      "step": 1,
      "title": {
        "en": "Prepare the Fish",
        "bn": "মাছ প্রস্তুত করুন"
      },
      "description": {
        "en": "Clean the Kakila fish thoroughly. Rub with a little turmeric and salt. Keep aside for 10 minutes.",
        "bn": "কাকিলা মাছ ভালোভাবে পরিষ্কার করুন। অল্প হলুদ ও লবণ মেখে ১০ মিনিট রেখে দিন।"
      }
    },
    {
      "step": 2,
      "title": {
        "en": "Lightly Fry the Fish",
        "bn": "মাছ হালকা ভেজে নিন"
      },
      "description": {
        "en": "Heat mustard oil in a pan. Lightly fry the Kakila fish for 1–2 minutes on each side until the surface firms up. Remove and set aside.",
        "bn": "সরিষার তেল গরম করে কাকিলা মাছ প্রতি পাশে ১–২ মিনিট হালকা ভেজে নিন যতক্ষণ না উপরের অংশ শক্ত হয়। তুলে রাখুন।"
      }
    },
    {
      "step": 3,
      "title": {
        "en": "Make the Gravy Base",
        "bn": "ঝোলের বেস তৈরি করুন"
      },
      "description": {
        "en": "In the same oil, add sliced onion and fry until soft. Add turmeric, chili powder, cumin powder, and salt. Mix well. Add chopped tomato and potato pieces. Stir for 2–3 minutes.",
        "bn": "একই তেলে পেঁয়াজ কুচি দিয়ে নরম করে ভাজুন। হলুদ, মরিচের গুঁড়া, জিরা গুঁড়া ও লবণ দিয়ে মিশিয়ে নিন। কুচি করা টমেটো ও আলুর টুকরো দিয়ে ২–৩ মিনিট নাড়ুন।"
      }
    },
    {
      "step": 4,
      "title": {
        "en": "Add Water and Fish",
        "bn": "পানি ও মাছ দিন"
      },
      "description": {
        "en": "Pour in the water and bring to a boil. Gently add the fried Kakila fish and green chilies. Cover and cook on medium-low heat for 10–12 minutes until the potatoes are soft and the gravy is light.",
        "bn": "পানি দিয়ে ফুটিয়ে তুলুন। ভাজা কাকিলা মাছ ও কাঁচা মরিচ আলতো করে দিন। ঢাকনা দিয়ে মিডিয়াম-লো আঁচে ১০–১২ মিনিট রান্না করুন যতক্ষণ না আলু নরম হয় এবং ঝোল হালকা হয়।"
      }
    },
    {
      "step": 5,
      "title": {
        "en": "Finish and Serve",
        "bn": "শেষ করুন ও পরিবেশন করুন"
      },
      "description": {
        "en": "Check seasoning. Sprinkle chopped coriander leaves. Serve hot with steamed rice.",
        "bn": "স্বাদ দেখে নিন। ধনেপাতা কুচি ছিটিয়ে দিন। গরম গরম ভাতের সাথে পরিবেশন করুন।"
      }
    }
  ],

  "tips": [
    {
      "en": "Keep the gravy thin and light — that is the characteristic of a good Bangladeshi jhol.",
      "bn": "ঝোল হালকা ও পাতলা রাখুন — এটাই ভালো বাংলাদেশি ঝোলের বৈশিষ্ট্য।"
    },
    {
      "en": "Do not over-fry the small Kakila fish; just a light fry is enough so it doesn’t break in the gravy.",
      "bn": "ছোট কাকিলা মাছ বেশি ভাজবেন না; শুধু হালকা ভেজে নিলেই হবে যাতে ঝোলে না ভাঙে।"
    },
    {
      "en": "This everyday jhol pairs wonderfully with plain rice and a simple dal.",
      "bn": "এই দৈনন্দিন ঝোল সাদা ভাত ও সাধারণ ডালের সাথে চমৎকার লাগে।"
    }
  ],

